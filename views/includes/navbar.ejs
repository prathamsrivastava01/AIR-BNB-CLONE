<style>
/* Navbar always on top */
.navbar {
  background-color: #fff !important;
  z-index: 1050;
  position: relative;
  border: 2px solid green;
}

/* Search */
.search-btn {
  background-color: #fe424d;
  color: #fff;
  border-radius: 25px;
  padding: 0 1rem;
}

.search-btn:hover {
  background-color: #fe424d;
  color: #fff;
}

.search-inp {
  border-radius: 25px;
  padding: 0.5rem 1rem;
}

/* Mobile menu */
.navbar-collapse {
  background-color: #fff;
  padding: 1rem;
  position: absolute;
  top: 100%;
  left: 0;
  width: 100%;
  z-index: 1051; /* overlay se upar */
}

/* Overlay (background only) */
.mobile-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.5);
  z-index: 1040; /* navbar ke neeche */
  display: none;
}
.auth-link {
  position: relative;
  font-weight: 500;
  transition: all 0.3s ease;
}

/* underline animation */
.auth-link::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: -2px;
  width: 0%;
  height: 2px;
  background: #fe424d;
  transition: 0.3s;
}

.auth-link:hover::after {
  width: 100%;
}

/* slight color change */
.auth-link:hover {
  color: #fe424d !important;
}

/* Responsive */
@media (max-width: 768px) {
  .search-inp {
    width: 100%;
    margin-bottom: 10px;
  }

  .search-btn {
    width: 100%;
  }

  .navbar-nav {
    text-align: center;
  }
}
</style>

<nav class="navbar navbar-expand-md border-bottom sticky-top">
  <div class="container-fluid d-flex align-items-center">

    <!-- LEFT -->
    <div class="d-flex align-items-center">
      <a class="navbar-brand me-3" href="/listings">
        <i class="fa-regular fa-compass"></i>
      </a>
      <a class="nav-link fw-medium" href="/listings">Explore</a>
    </div>

    <!-- TOGGLE -->
    <button 
      class="navbar-toggler ms-auto" 
      type="button" 
      data-bs-toggle="collapse" 
      data-bs-target="#navbarNavAltMarkup">
      <span class="navbar-toggler-icon"></span>
    </button>

          <!-- CENTER SEARCH -->
      <!-- <div class="mx-auto my-2 my-md-0">
        <form class="d-flex flex-column flex-md-row" role="search">
          <input 
            class="form-control me-md-2 search-inp" 
            type="search" 
            placeholder="Search destinations"
          />
          <button class="btn search-btn mt-2 mt-md-0" type="submit">
            <i class="fa-solid fa-magnifying-glass"></i> Search
          </button>
        </form>
      </div> -->

      <!-- RIGHT -->
      <div class="d-flex align-items-center gap-3 ms-md-auto">

        <a class="nav-link fw-medium" href="/listings/new">Airbnb your home</a>

        <% if(!currUser){ %>
          <a class="nav-link auth-link" href="/signup">Sign up</a>
          <a class="nav-link auth-link" href="/login">Log in</a>
        <% } %>

        <% if(currUser) { %>
          <a class="nav-link auth-link" href="/logout">Log out</a>
        <% } %>

      </div>


  </div>
</nav>

<!-- PAGE CONTENT -->
<!-- <div class="container mt-3">
  <h3>All Listings</h3>
</div> -->

<!-- ✅ Overlay ALWAYS OUTSIDE NAVBAR -->
<div class="mobile-overlay"></div>
<script>
const navbarCollapse = document.getElementById("navbarNavAltMarkup");
const overlay = document.querySelector(".mobile-overlay");

navbarCollapse.addEventListener("show.bs.collapse", () => {
  overlay.style.display = "block";
});

navbarCollapse.addEventListener("hide.bs.collapse", () => {
  overlay.style.display = "none";
});

// click overlay to close
overlay.addEventListener("click", () => {
  const bsCollapse = bootstrap.Collapse.getInstance(navbarCollapse);
  if (bsCollapse) {
    bsCollapse.hide();
  }
});
</script>